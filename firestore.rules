rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 多店舗在庫管理システム Firestoreセキュリティルール
//
// 調査結果に基づく設計方針:
// - 未認証アクセスは一切不要（ログイン画面・サインアップ画面はFirestoreに
//   触れないため確認済み）→ 全コレクションで request.auth != null を前提にする
// - inventory_shared_v1 配下は org_{orgId}__ プレフィックスで組織スコープ
// - 統括管理者（superadmin）はメールアドレス固定判定で全組織を横断
// - billing_* は統括管理者のみ、orders確定/order_saved_pdfs/
//   pos_stripe_settings/store_quantity_limits の書き込みは組織admin以上
// - それ以外は同組織メンバーなら読み書き可
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 共通ヘルパー ──────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // アプリ全体で唯一のハードコードされた統括管理者アカウント
      // （lib/core/app_session.dart の AppSession.isSuperAdmin と同じ判定）
      return isSignedIn() && request.auth.token.email == 're.start.niigata@gmail.com';
    }

    // 自分自身の users/{uid} ドキュメントから orgId / role を取得する。
    // ドキュメントが存在しない場合（サインアップ直後〜組織設定完了前の
    // 中間状態）は「無所属」として扱う。
    function myOrgId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : '';
    }

    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // 自分の所属店舗ID一覧（請求非開示の解除など、店舗スタッフ本人の
    // 所属店舗に限定した操作の判定に使う）。未設定なら空リスト。
    function myStoreIds() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeIds is list
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeIds
        : [];
    }

    // 管理者判定は role だけでなく orgId が空でないことも必須にする
    // （脱退・削除直後は role:'admin' のまま orgId が空になるため）
    function isOrgAdmin(orgId) {
      return orgId != '' && myOrgId() == orgId && myRole() == 'admin';
    }

    function isOrgMember(orgId) {
      return orgId != '' && myOrgId() == orgId;
    }

    // inventory_shared_v1 のドキュメントIDは "org_{orgId}__{suffix}" 形式。
    // 部分文字列の抽出関数が使えないため、自分のorgIdを埋め込んだ正規表現で
    // 「このドキュメントは自分の組織のものか」を判定する。
    function isLegacyDocId(id) {
      return !id.matches('^org_.*');
    }

    function isMyOrgDocId(id) {
      return myOrgId() != '' && id.matches('^org_' + myOrgId() + '__.*$');
    }

    function isMyOrgAdminDocId(id) {
      return myOrgId() != '' && myRole() == 'admin' &&
        id.matches('^org_' + myOrgId() + '__.*$');
    }

    // 統括管理者のみ読み書き可能なドキュメント（請求・受領管理）
    function isBillingDocId(id) {
      return id.matches('.*__billing_invoices$') ||
             id.matches('.*__billing_invoice_pdfs$') ||
             id.matches('.*__billing_receipts$') ||
             id.matches('.*__billing_receipt_pdfs$');
    }

    // "org_{orgId}__billing_invoices" 等から、対応する
    // "org_{orgId}__stores" のドキュメントIDを求める
    // (統括管理者は自分の所属組織に関わらず任意の組織のbillingドキュメントを
    // 扱えるため、request側のmyOrgId()ではなく対象ドキュメントIDから
    // 組織を特定する必要がある)。
    function billingStoresDocId(billingDocId) {
      return billingDocId.split('__')[0] + '__stores';
    }

    // 請求・受領entries 1件が、非開示店舗に属しておらず、かつ
    // (非開示から開示された場合は)統括管理者の確認済みか(=閲覧してよいか)。
    // billing_visibilityドキュメントが無い店舗は非開示ではない(デフォルト)。
    //
    // 例外: そのドキュメントの発行者本人(createdByUid == 現在のuid)であれば、
    // 非開示・確認待ちの状態でも自分の発行履歴として閲覧を許可する。
    // createdByUidが未設定の過去データは一致しないため、従来の非開示ルールに従う。
    function billingEntryVisible(billingDocId, storeId) {
      return resource.data.get('createdByUid', '') == request.auth.uid ||
        storeId == '' ||
        !exists(/databases/$(database)/documents/inventory_shared_v1/$(billingStoresDocId(billingDocId))/billing_visibility/$(storeId)) ||
        (get(/databases/$(database)/documents/inventory_shared_v1/$(billingStoresDocId(billingDocId))/billing_visibility/$(storeId)).data.hidden != true &&
         get(/databases/$(database)/documents/inventory_shared_v1/$(billingStoresDocId(billingDocId))/billing_visibility/$(storeId)).data.superAdminAcknowledged == true);
    }

    // 書き込みは組織admin以上に限定するドキュメント
    // （orders自体・納品処理・既存発注表の更新は全員に開放し、
    //   ここでは「発注確定」に相当する新規バッチ作成のみを別途battchesで扱う）
    function isAdminWriteDocId(id) {
      return id.matches('.*__pos_stripe_settings$') ||
             id.matches('.*__store_quantity_limits$') ||
             id.matches('.*__order_saved_pdfs$');
    }

    function isStoresDocId(id) {
      return id.matches('.*__stores$');
    }

    // ── users ────────────────────────────────────────────
    // 読み取り: 認証済みなら誰でも可（組織参加時の人数チェック等で
    //           他組織メンバーの一覧を読む必要があるため現状維持）
    // 書き込み: 本人のみ。ただし orgId は
    //           「現在空文字（無所属）→ 任意の値に設定」または
    //           「現在の値のまま変更しない」または
    //           「現在の値 → 空文字（脱退）」の3パターンのみ許可。
    //           これにより、一度組織に参加した後に自分のorgIdを
    //           勝手に他組織のIDへ書き換える「なりすまし参加」を防ぐ。
    //           別のメンバーのorgId/roleは、そのメンバーが現在所属する
    //           組織のadmin（または統括管理者）だけがリセット可能
    //           （メンバー削除処理用、orgId/role以外は変更不可）。
    //           別のメンバーの storeIds（所属店舗・閲覧権限範囲）も、
    //           同様に組織admin（または統括管理者）だけが変更可能
    //           （このメンバー管理画面の店舗閲覧設定用、他フィールドは
    //           一切変更不可）。
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['admin', 'member'];

      allow update: if isSignedIn() && (
        (request.auth.uid == uid && (
          resource.data.orgId == '' ||
          (request.resource.data.orgId == resource.data.orgId &&
           request.resource.data.role == resource.data.role) ||
          (request.resource.data.orgId == '' && request.resource.data.role == 'admin')
        ))
        ||
        (request.auth.uid != uid &&
         (isOrgAdmin(resource.data.orgId) || isSuperAdmin()) &&
         (
           (request.resource.data.orgId == '' &&
            request.resource.data.role == 'admin' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orgId', 'role']))
           ||
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeIds'])
         ))
      );

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── orgs（組織メタデータ：名前・ロゴ・招待コード・上限設定など）──
    // 読み取り: 認証済みなら誰でも可
    //           （広告配信機能が他組織のadSlots等を横断的に読む、
    //            招待コード参加フローが参加前の組織情報を読む必要がある）
    // 作成: 現在どの組織にも属していないユーザーのみ（新規組織作成）
    // 更新・削除: 自組織の管理者、または統括管理者のみ
    match /orgs/{orgId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && myOrgId() == '';

      allow update, delete: if isSignedIn() &&
        (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // ── organizations（旧システムの組織コレクション・移行専用）──
    // 読み取りのみ維持（初回ログイン時の自動移行チェックで使用）。
    // 現行コードはこのコレクションに書き込まないため、書き込みは禁止。
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── inventory_shared_v1（組織ごとの業務データ）──────────
    match /inventory_shared_v1/{docId} {

      // 旧形式（org_プレフィックスなし）のドキュメントは読み取りのみ維持
      allow read: if isSignedIn() && (
        isLegacyDocId(docId) ||
        (isBillingDocId(docId) ? isSuperAdmin() : (isMyOrgDocId(docId) || isSuperAdmin()))
      );

      allow write: if isSignedIn() && !isLegacyDocId(docId) && (
        isBillingDocId(docId) ? isSuperAdmin() :
        isAdminWriteDocId(docId) ? (isMyOrgAdminDocId(docId) || isSuperAdmin()) :
        (isMyOrgDocId(docId) || isSuperAdmin())
      );

      // history / order_request_history / order_delivery_status /
      // order_saved_pdfs / billing_* / pos_sales / pos_receipt_pdfs 等の
      // "entries" サブコレクション
      match /entries/{entryId} {
        // billing_* のentriesは、非開示店舗(billing_visibility.hidden==true)の
        // ものを統括管理者からも読めなくする。他のentries種別は従来通り。
        //
        // get(ドキュメントIDを指定した個別取得)とlist(クエリでの一覧取得)を
        // 分けているのは、Firestoreルールがlist操作に対しては
        // ドキュメントごとの絞り込みを保証しない(get()に依存する条件を
        // list側で使うと、正しいドキュメントも含めてクエリ全体が
        // 評価エラーで拒否されることを実機検証で確認した)ため。
        // list側はisSuperAdmin()のみとし、非開示店舗の除外はクライアント側の
        // where('storeId', whereNotIn: ...)クエリ + 取得後フィルタで行う
        // (billing_page.dart)。get側はentryごとに正しく非開示チェックが
        // かかるため、非開示店舗のドキュメントIDを直接指定した個別アクセスは
        // 統括管理者であっても拒否される。
        allow get: if isSignedIn() && (
          isBillingDocId(docId)
            ? (isSuperAdmin() && billingEntryVisible(docId, resource.data.get('storeId', '')))
            : (isMyOrgDocId(docId) || isSuperAdmin())
        );
        allow list: if isSignedIn() && (
          isBillingDocId(docId) ? isSuperAdmin() : (isMyOrgDocId(docId) || isSuperAdmin())
        );
        allow write: if isSignedIn() && (
          isBillingDocId(docId) ? isSuperAdmin() :
          isAdminWriteDocId(docId) ? (isMyOrgAdminDocId(docId) || isSuperAdmin()) :
          (isMyOrgDocId(docId) || isSuperAdmin())
        );
      }

      // orders ドキュメント配下の発注バッチ。
      // 新規作成（＝発注確定）は組織admin以上のみ。
      // 既存バッチの読み取り・更新（納品処理・取消・訂正等）は組織メンバー全員可。
      match /batches/{batchId} {
        allow read, update, delete: if isSignedIn() &&
          (isMyOrgDocId(docId) || isSuperAdmin());
        allow create: if isSignedIn() &&
          (isMyOrgAdminDocId(docId) || isSuperAdmin());
      }

      // storesドキュメント配下、店舗ごとの請求・受領・領収書の非開示状態。
      // { hidden: bool, superAdminAcknowledged: bool }
      // stores自体のitems配列に持たせると、配列内の特定1要素だけを検証する
      // 手段がFirestoreルールに無いため（.all()/.exists()等の反復処理は
      // 未サポート、実機検証済み）、店舗ごとに独立したドキュメントに分けて
      // 方向ごとに権限を強制する。
      match /billing_visibility/{storeId} {
        allow read: if isSignedIn() && (isMyOrgDocId(docId) || isSuperAdmin());

        // 非開示にする(hidden: 未設定/false → true): 統括管理者のみ。
        // superAdminAcknowledgedは常にfalseにリセットする(再度開示された
        // 際に、統括管理者の確認操作を改めて必要にするため)。
        allow create, update: if isSignedIn() && isStoresDocId(docId) &&
          isSuperAdmin() &&
          request.resource.data.hidden == true &&
          request.resource.data.superAdminAcknowledged == false &&
          request.resource.data.keys().hasOnly(['hidden', 'superAdminAcknowledged']);

        // 開示する(hidden: true → false): その店舗の所属メンバーのみ。
        // superAdminAcknowledgedはfalseのまま(統括管理者はまだ未確認)。
        allow update: if isSignedIn() && isStoresDocId(docId) &&
          isMyOrgDocId(docId) && storeId in myStoreIds() &&
          resource.data.hidden == true &&
          request.resource.data.hidden == false &&
          request.resource.data.superAdminAcknowledged == false &&
          request.resource.data.keys().hasOnly(['hidden', 'superAdminAcknowledged']);

        // 開示を確認する(superAdminAcknowledged: false → true): 統括管理者のみ。
        // 店舗側が開示(hidden: false)にした後、初めてその内容を見るための
        // 確認操作。hiddenはfalseのまま変えない。
        allow update: if isSignedIn() && isStoresDocId(docId) &&
          isSuperAdmin() &&
          resource.data.hidden == false &&
          resource.data.superAdminAcknowledged == false &&
          request.resource.data.hidden == false &&
          request.resource.data.superAdminAcknowledged == true &&
          request.resource.data.keys().hasOnly(['hidden', 'superAdminAcknowledged']);

        allow delete: if false;
      }
    }

    // ── それ以外の未定義パスはすべて拒否 ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
